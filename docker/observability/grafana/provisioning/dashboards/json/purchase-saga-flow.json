              "topic": 5,
              "orderId": 6,
              "orderStatus": 7,
              "sagaStatus": 8,
              "reason": 9,
              "exceptionType": 10,
              "errorMessage": 11
            },
            "renameByName": {
              "Time": "Time",
              "action": "Action",
              "errorMessage": "Error Message",
              "eventId": "Event ID",
              "eventType": "Event Type",
              "exceptionType": "Exception Type",
              "orderId": "Order ID",
              "orderStatus": "Order Status",
              "reason": "Reason",
              "sagaStatus": "Saga Status",
              "service": "Service",
              "topic": "Topic"
            }
          }
        }
      ],
      "type": "table"
    },
