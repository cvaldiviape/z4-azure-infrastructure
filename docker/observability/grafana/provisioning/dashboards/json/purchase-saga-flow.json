          },
          "direction": "forward",
          "editorMode": "code",
          "expr": "{environment=\"local\", service_name=\"order-service\"} |~ \"correlationId=$correlationId(?:\\\\s|$)\" |= \"action=saga_state_changed\" |= \"sagaStatus=COMPLETED\"",
          "queryType": "range",
          "refId": "A"
        }
      ],
      "title": "3. Fin de la Saga",
      "type": "logs"
    },
    {
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "description": "Tabla estructurada y ordenada desde el inicio hasta el final usando la hora original de Spring Boot.",
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            },
            "filterable": true,
            "inspect": false
          }
        },
        "overrides": []
      },
      "gridPos": {
        "h": 13,
        "w": 24,
        "x": 0,
        "y": 7
      },
      "id": 3,
      "options": {
        "cellHeight": "sm",
        "footer": {
          "countRows": false,
          "enablePagination": false,
          "fields": "",
          "reducer": [
            "sum"
          ],
          "show": false
        },
        "showHeader": true
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "direction": "forward",
          "editorMode": "code",
          "expr": "{environment=\"local\", service_name=~\"$service\"} |~ \"correlationId=$correlationId(?:\\\\s|$)\" |~ \"action=(saga_started|saga_state_changed|event_received|event_published|event_processed|event_ignored|payment_approved|payment_rejected|event_processing_failed|event_publish_failed)\" | regexp \"(?P<business_log>action=.*)\" | line_format \"service={{.service_name}} {{.business_log}}\" | drop service_name, filename, detected_level, business_log",
          "queryType": "range",
          "refId": "A"
        }
      ],
      "title": "2. Flujo cronológico estructurado: inicio → fin",
      "transformations": [
        {
          "id": "extractFields",
          "options": {
            "format": "kvp",
            "keepTime": true,
            "replace": true,
            "source": "Line"
          }
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "correlationId": true,
              "offset": true,
              "partition": true,
              "paymentId": true,
              "producer": true
